{
    "name": "acsi/auth-code",
    "description": "Token-based (email code) authentication for Laravel — login codes, registration with email verification, roles, and admin gating.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "auth", "login-code", "registration", "token"],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Acsi\\AuthCode\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acsi\\AuthCode\\AuthCodeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}